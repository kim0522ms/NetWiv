      "fixture": "window.effects-validation",
      "sources": ["native/netwiv-native/src/runtime/options.rs", "native/netwiv-native/src/runtime/platform.rs"],
      "apis": ["window.Window.setEffects", "webviewWindow.WebviewWindow.setEffects", "window.WindowOptions.windowEffects"],
      "limits": "Both public setters validate the pinned WindowEffectsConfig, clear null/absent effects, accept supported values and preserve exact malformed-input errors. Invalid constructor options fail without allocating a window. Windows applies supported effects; Linux validates then performs the upstream no-op. Visual appearance and macOS effects are not established by this fixture."
    },
    {
      "fixture": "security.frame-origins",
      "sources": ["src/NetWiv.Core/Ipc/InitializationScript.cs", "src/NetWiv.Core/Ipc/AppHandle.Protocol.cs", "src/NetWiv.Core/Security/Acl.cs", "native/netwiv-native/src/runtime/webview.rs", "native/netwiv-native/src/runtime/protocol.rs"],
      "apis": ["core.invoke", "core.isTauri"],
      "limits": "Standard protocol IPC compares trusted and untrusted remote windows, local/remote/opaque child frames and spoofed origin fields. Windows authorizes each frame by browser Origin; pinned WebKitGTK exposes the bridge only in the main frame. Local/trusted positive controls must succeed. Isolation child frames and forced fallback transport are outside this fixture."
    },
