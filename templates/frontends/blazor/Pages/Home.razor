@page "/"
@page "/index.html"
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@AppName</PageTitle>
<div class="starter">
    <header class="bar">
        <span class="brand"><svg class="mark" viewBox="76 88 348 348" aria-hidden="true"><rect class="back" x="160" y="88" width="264" height="264" rx="48"/><rect class="gap" x="76" y="148" width="288" height="288" rx="60"/><rect class="front" x="88" y="160" width="264" height="264" rx="48"/><path class="letter" d="M152 360V224h40l56 100V224h40v136h-40l-56-100v100z"/></svg><span>@AppName</span></span>
        <span class="status" data-state="@StatusState" aria-live="polite">@StatusText</span>
    </header>
    <main class="split">
        <section class="call" aria-labelledby="heading">
            <h1 id="heading">@(Bridge ? "Your window is running. Call the C# backend." : "This page is outside the NetWiv window.")</h1>
            <form class="ask" @onsubmit="Greet" @onsubmit:preventDefault="true">
                <label for="name">Name</label>
                <div class="row">
                    <input id="name" @bind="Name" autocomplete="off" required />
                    <button disabled="@(State == CallState.Calling)">@(State == CallState.Calling ? "Calling…" : "Call greet")</button>
                </div>
            </form>
            <div class="answer" data-state="@AnswerState" aria-live="polite">
                <p class="route">commands.greet → Commands.Greet</p>
                @if (State == CallState.Failed)
                {
                    <p class="message">C# did not answer</p>
                    <p class="detail">@(Bridge ? "The greet command failed in C#. Greet is in src-netwiv/Program.cs." : "Start the app with netwiv dev so this page runs inside the NetWiv window.")<code>@Error</code></p>
                }
                else
                {
                    <p @key="Count" class="@(Count is null ? "message" : "message landed")">@(State == CallState.Calling && Count is null ? "Waiting for C#…" : Message)</p>
                    <dl class="count"><dt>Calls counted in C#</dt><dd @key="Count" class="@(Count is null ? null : "landed")">@(Count?.ToString() ?? "—")</dd></dl>
                }
            </div>
        </section>
        <aside class="map" aria-labelledby="map-heading">
            <h2 id="map-heading">Make it yours</h2>
            <ul class="files">
                <li><code>frontend/Pages/Home.razor</code><span>This screen. Replace it with your interface.</span></li>
                <li><code>src-netwiv/Program.cs</code><span>Commands, state and the window. Greet is defined here.</span></li>
                <li><code>frontend/wwwroot/netwiv.js</code><span>Connects Blazor to your C# commands through @@netwiv/api.</span></li>
                <li><strong>netwiv.github.io</strong><span>Guides and the API reference.</span></li>
            </ul>
        </aside>
    </main>
</div>

@code {
    private enum CallState { Idle, Calling, Answered, Failed }

    private IJSObjectReference? NetWiv;
    private string AppName = "NetWiv app";
    private bool Bridge = true;
    private string Name = "Blazor";
    private CallState State = CallState.Idle;
    private string Message = "No call yet";
    private int? Count;
    private long Ms;
    private string Error = "";
    private bool Smoke;

    private string StatusText => State switch
    {
        CallState.Calling => "Calling C#",
        CallState.Answered => $"Answered in {Ms} ms",
        CallState.Failed => "No answer",
        _ => Bridge ? "Ready" : "Not in a NetWiv window",
    };
    private string StatusState => State == CallState.Idle && !Bridge ? "offline" : State.ToString().ToLowerInvariant();
    private string AnswerState => State == CallState.Calling ? (Count is null ? "idle" : "answered") : State.ToString().ToLowerInvariant();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        NetWiv = await JS.InvokeAsync<IJSObjectReference>("import", "./netwiv.js");
        try { AppName = await NetWiv.InvokeAsync<string>("name"); }
        catch (JSException) { Bridge = false; }
        // Smoke tests open the window with ?smoke=1 and expect one automatic call.
        Smoke = new Uri(Navigation.Uri).Query.Contains("smoke", StringComparison.Ordinal);
        if (Smoke) await Greet();
        StateHasChanged();
    }

    private async Task Greet()
    {
        if (NetWiv is null) return;
        State = CallState.Calling;
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        try
        {
            var result = await NetWiv.InvokeAsync<Greeting>("greet", Name);
            Ms = (long)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds;
            Message = result.Message;
            Count = result.Count;
            State = CallState.Answered;
            if (Smoke)
            {
                if (result.Message != "Hello, Blazor!" || result.Count != 1)
                    throw new InvalidOperationException($"Unexpected C# response: {result}");
                await NetWiv.InvokeVoidAsync("smokeDone", "PASS: Blazor form → generated C# → JSON");
            }
        }
        catch (Exception error) when (error is JSException or InvalidOperationException)
        {
            Error = error.Message;
            State = CallState.Failed;
            if (Smoke) await NetWiv.InvokeVoidAsync("smokeDone", $"FAIL: {error.Message}");
        }
    }

    private sealed record Greeting(string Message, int Count);
}
