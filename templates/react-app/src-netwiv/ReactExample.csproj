<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <NetWivVersion>0.1.0-dev</NetWivVersion>
    <NetWivFrontendDist>$(MSBuildProjectDirectory)/../dist</NetWivFrontendDist>
    <NetWivFrontendBindingsDirectory>../src/generated</NetWivFrontendBindingsDirectory>
    <NetWivConfigPath Condition="'$(NetWivConfigPath)' == ''">$(MSBuildProjectDirectory)/netwiv.conf.json</NetWivConfigPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetWiv.Platform.Desktop" Version="$(NetWivVersion)" />
    <PackageReference Include="NetWiv.Build" Version="$(NetWivVersion)" PrivateAssets="all" />
    <PackageReference Include="NetWiv.Generators" Version="$(NetWivVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(NetWivBindingsOnly)' != 'true' and '$(NetWivDevelopment)' != 'true'">
    <ProjectReference Include="../ReactExample.Frontend.esproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Import Project="Frontend.targets" />
</Project>
