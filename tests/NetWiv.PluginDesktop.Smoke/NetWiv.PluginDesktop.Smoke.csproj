<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetWiv.Platform.Desktop/NetWiv.Platform.Desktop.csproj" />
    <ProjectReference Include="../../src/NetWiv.Plugin.ClipboardManager/NetWiv.Plugin.ClipboardManager.csproj" />
    <ProjectReference Include="../../src/NetWiv.Plugin.Dialog/NetWiv.Plugin.Dialog.csproj" />
    <ProjectReference Include="../../src/NetWiv.Plugin.Notification/NetWiv.Plugin.Notification.csproj" />
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="netwiv.assets.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="netwiv.conf.json" LogicalName="netwiv.config.json" />
    <EmbeddedResource Include="../../templates/frontends/shared/vendor/@netwiv/api/**/*.js" LogicalName="netwiv.assets.vendor/@netwiv/api/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequirePinnedGuest" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../templates/frontends/shared/vendor/@netwiv/api/core.js')" Text="Build packages/api and run node scripts/generate-frontend-template-overlays.mjs before building the desktop plugin smoke." />
  </Target>
</Project>
