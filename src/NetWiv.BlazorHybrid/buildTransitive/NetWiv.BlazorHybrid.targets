<Project>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' == ''">false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Target Name="NetWivValidateBlazorHybridNativeAot" BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(PublishAot)' == 'true'">
    <Error Condition="'$(NetWivBlazorExperimentalAot)' != 'true'"
           Text="NetWiv.BlazorHybrid NativeAOT hosting is experimental. Use managed Hybrid by default. To opt in, set NetWivBlazorExperimentalAot=true and register AddNetWivBlazorHybridAot explicitly." />
    <Error Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' == 'true'"
           Text="Experimental NetWiv.BlazorHybrid NativeAOT requires source-generated JSON metadata. Use AddNetWivBlazorHybridAot and set JsonSerializerIsReflectionEnabledByDefault=false." />
  </Target>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../licenses/dotnet-runtime-MIT.txt')">
    <None Include="$(MSBuildThisFileDirectory)../licenses/dotnet-runtime-MIT.txt"
          Link="NetWiv.BlazorHybrid.MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../licenses/Microsoft.AspNetCore.Components.WebView.NOTICES.txt')">
    <None Include="$(MSBuildThisFileDirectory)../licenses/Microsoft.AspNetCore.Components.WebView.NOTICES.txt"
          Link="Microsoft.AspNetCore.Components.WebView.NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
