<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <NetWivBlazorTargetFramework Condition="'$(NetWivBlazorTargetFramework)' == ''">net8.0</NetWivBlazorTargetFramework>
    <TargetFramework>$(NetWivBlazorTargetFramework)</TargetFramework>
    <BlazorFrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.32</BlazorFrameworkVersion>
    <BlazorFrameworkVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.21</BlazorFrameworkVersion>
    <BlazorFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.13</BlazorFrameworkVersion>
    <NetWivBlazorMode Condition="'$(NetWivBlazorMode)' == ''">Hybrid</NetWivBlazorMode>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/HybridUiRegistration.cs') and '$(NetWivBindingsOnly)' != 'true'">
    <_BlazorHostFlavor>$(NetWivBlazorMode)</_BlazorHostFlavor>
    <_BlazorHostFlavor Condition="'$(NetWivBlazorExperimentalAot)' == 'true'">HybridExperimentalAot</_BlazorHostFlavor>
    <BaseOutputPath Condition="'$(ArtifactsPath)' == '' and '$(UseArtifactsOutput)' != 'true'">bin/$(_BlazorHostFlavor)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(ArtifactsPath)' == '' and '$(UseArtifactsOutput)' != 'true'">obj/$(_BlazorHostFlavor)/</BaseIntermediateOutputPath>
    <ArtifactsProjectName>$(MSBuildProjectName)-$(_BlazorHostFlavor)</ArtifactsProjectName>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- The shared UI generates its client with a separate backend build. -->
  <PropertyGroup Condition="'$(NetWivBindingsOnly)' == 'true'">
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/bindings/$(Configuration)/$(TargetFramework)/</MSBuildProjectExtensionsPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)/obj/bindings/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)/bin/bindings/$(Configuration)/$(TargetFramework)/</OutputPath>
  </PropertyGroup>
</Project>
