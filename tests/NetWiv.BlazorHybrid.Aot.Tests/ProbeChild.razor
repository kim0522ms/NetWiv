@namespace NetWiv.BlazorHybrid.Aot.Tests
@using Microsoft.AspNetCore.Components
@inject ProofScope Scope

<output id="cascade" data-same-scope="@(ReferenceEquals(Scope, ExpectedScope).ToString())">@Label:@Value</output>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public ProofScope? ExpectedScope { get; set; }
    [CascadingParameter] public string Value { get; set; } = "";
}
