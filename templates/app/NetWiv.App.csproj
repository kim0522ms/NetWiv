<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <NetWivVersion>__NETWIV_VERSION__</NetWivVersion>
    <NetWivConfigPath Condition="'$(NetWivConfigPath)' == ''">$(MSBuildProjectDirectory)/netwiv.conf.json</NetWivConfigPath>
    <NetWivFrontendBindingsDirectory>../src/generated</NetWivFrontendBindingsDirectory>
    <DefineConstants Condition="'$(NetWivDevelopment)' == 'true'">$(DefineConstants);NETWIV_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
__NETWIV_REFERENCES__
  </ItemGroup>
__NETWIV_BUILD_IMPORT__
</Project>
