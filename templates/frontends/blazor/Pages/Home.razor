@page "/"
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript

<PageTitle>NetWiv + Blazor</PageTitle>
<h1>NetWiv + Blazor</h1>
<form @onsubmit="Greet" @onsubmit:preventDefault="true">
    <input aria-label="Name" @bind="Name" />
    <button type="submit">Greet</button>
</form>
<p>@Message</p>

@code {
    private string Name = "World";
    private string Message = "";

    private async Task Greet()
    {
        try
        {
            var result = await JavaScript.InvokeAsync<Greeting>("netwivGreet", Name);
            Message = $"{result.Message} (#{result.Count})";
        }
        catch (Exception error)
        {
            Message = error.Message;
        }
    }

    private sealed record Greeting(string Message, int Count);
}
