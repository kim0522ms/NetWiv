<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <NetWivFrontendDist>$(MSBuildProjectDirectory)/wwwroot</NetWivFrontendDist>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetWiv.Platform.Desktop" Version="0.1.0-beta.1" />
    <PackageReference Include="NetWiv.Build" Version="0.1.0-beta.1" PrivateAssets="all" />
    <PackageReference Include="NetWiv.Generators" Version="0.1.0-beta.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
