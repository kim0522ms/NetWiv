  "permissions": [
    "core:default",
    "contract:allow-read-config",
    "literal-command-keys",
    { "identifier": "scope-pair", "allow": ["extension"] },
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:webview:allow-reparent",
    "core:webview:allow-set-webview-auto-resize",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-background-color",
    "core:window:allow-create",
    "core:window:allow-destroy",
    "core:window:allow-set-background-color",
    "core:window:allow-set-effects",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-progress-bar",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-resizable",
    "core:window:allow-set-closable",
    "core:window:allow-set-decorations",
    "core:window:allow-set-enabled",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-minimizable",
    "core:window:allow-set-maximizable",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:app:allow-fetch-data-store-identifiers",
    "core:app:allow-remove-data-store",
    "core:app:allow-app-show",
    "core:app:allow-app-hide",
    "core:app:allow-set-dock-visibility",
    "allow-echo-json",
    "allow-asset-fixture",
    "allow-always-fails",
    "allow-echo-bytes",
    "allow-stream-numbers",
    "allow-custom-default-allowed",
    "allow-typed-request",
    "allow-conformance-record",
    "allow-conformance-finish",
    "allow-conformance-profile",
    "allow-conformance-cases",
    "allow-conformance-platform",
    "allow-create-data-store-fixture"
