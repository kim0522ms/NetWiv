<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the .NET 8 MSBuild contract; the host supplies these assemblies. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48" PrivateAssets="all" ExcludeAssets="runtime" />
    <Compile Include="../NetWiv.Build/Frontend/FrontendBindings.cs" Link="FrontendBindings.cs" />
    <Compile Include="../NetWiv.Build/Configuration/WindowsFileVersion.cs" Link="WindowsFileVersion.cs" />
    <Compile Include="../NetWiv.Build/Configuration/ApplicationVersion.cs" Link="ApplicationVersion.cs" />
    <Compile Include="../NetWiv.Build/Packaging/ResourcePaths.cs" Link="ResourcePaths.cs" />
    <Compile Include="../NetWiv.Build/Packaging/ResourceStager.cs" Link="ResourceStager.cs" />
    <Compile Include="../NetWiv.Core/Security/LabelPattern.cs" Link="LabelPattern.cs" />
  </ItemGroup>
</Project>
