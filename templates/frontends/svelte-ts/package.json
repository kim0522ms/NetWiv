{
  "name": "netwiv-svelte-ts-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "bindings": "node scripts/generate-bindings.mjs",
    "predev": "node scripts/generate-bindings.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/generate-bindings.mjs && svelte-check --tsconfig ./tsconfig.json && vite build",
    "desktop:dev": "dotnet tool restore && dotnet tool run netwiv -- dev -- --dev",
    "desktop:build": "dotnet tool restore && dotnet tool run netwiv -- build --no-bundle"
  },
  "dependencies": {
    "@netwiv/api": "file:vendor/netwiv-api",
    "svelte": "5.56.3"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "typescript": "6.0.3",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "svelte-check": "4.6.0"
  }
}
