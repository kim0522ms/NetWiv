{
  "name": "netwiv-react-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "bindings": "node scripts/generate-bindings.mjs",
    "predev": "npm run bindings",
    "dev": "vite",
    "build": "npm run bindings && vite build",
    "desktop": "dotnet run --project src-netwiv",
    "desktop:dev": "dotnet tool restore && dotnet tool run netwiv -- dev -- --dev",
    "desktop:dev:backend": "dotnet watch --project src-netwiv --no-hot-reload run -p:NetWivDevelopment=true -- --dev",
    "smoke": "dotnet run --project src-netwiv -- --smoke-test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  }
}
