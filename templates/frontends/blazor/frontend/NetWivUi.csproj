<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly" TreatAsLocalProperty="AssemblyName;PublishAot;PublishSingleFile;UseAppHost">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorFrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.34</BlazorFrameworkVersion>
    <BlazorFrameworkVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.23</BlazorFrameworkVersion>
    <BlazorFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.15</BlazorFrameworkVersion>
    <!-- Desktop global publish flags must not change the browser project's restore. -->
    <AssemblyName>NetWivUi</AssemblyName>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(BlazorFrameworkVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(BlazorFrameworkVersion)" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="NetWiv.targets" />
</Project>
